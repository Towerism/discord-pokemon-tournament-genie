{
  "name": "tournament-genie",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev": "nuxt dev --port 3001",
    "build": "nuxt build && esbuild server/bootstrap/launcher.ts --bundle --platform=node --format=esm --target=node24 --packages=bundle --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=.output/launcher.mjs",
    "start": "node .output/launcher.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run --project unit --coverage && vitest run --project server",
    "test:unit": "vitest run --project unit",
    "test:server": "vitest run --project server",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.144",
    "@nuxt/ui": "^4.11.3",
    "@towerism/selfhost-kit": "0.4.2",
    "better-sqlite3": "^13.0.3",
    "discord.js": "14.27.0",
    "drizzle-orm": "^0.45.4",
    "h3": "^1.15.11",
    "nuxt": "^4.6.1",
    "nuxt-auth-utils": "^0.5.31",
    "nuxt-security": "^2.6.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.4",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "fast-xml-parser": "^5.11.2",
    "typescript": "~5.9.3",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13",
    "yaml": "^2.9.1"
  }
}
